{
  "name": "bm-ftp-commander",
  "displayName": "bm.ftp — FTP Commander",
  "description": "Browse local and FTP/FTPS directories in a Norton Commander-inspired VS Code panel.",
  "version": "0.1.0",
  "publisher": "local",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/vasva/bm.ftp.git"
  },
  "bugs": {
    "url": "https://github.com/vasva/bm.ftp/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["Other"],
  "keywords": ["ftp", "ftps", "commander", "file-manager"],
  "main": "./out/extension.js",
  "activationEvents": ["onCommand:bmFtp.open"],
  "contributes": {
    "commands": [
      {
        "command": "bmFtp.open",
        "title": "bm.ftp: Open FTP Commander"
      }
    ]
  },
  "scripts": {
    "build": "npm run build:webview && npm run compile:extension",
    "build:webview": "npm --workspace webview run build",
    "compile:extension": "tsc -p tsconfig.extension.json",
    "watch:extension": "tsc -p tsconfig.extension.json --watch",
    "package": "npm run build && vsce package --allow-missing-repository"
  },
  "dependencies": {
    "basic-ftp": "6.2.3"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/vscode": "1.140.0",
    "@vscode/vsce": "4.0.0",
    "typescript": "5.9.3"
  },
  "workspaces": ["webview"]
}
